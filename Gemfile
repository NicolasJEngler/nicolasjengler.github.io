source "https://rubygems.org"

# Mirror the GitHub Pages build environment so a local preview matches what
# actually gets deployed. The github-pages gem pins Jekyll 3.9.x, minima,
# jekyll-feed, jekyll-seo-tag and the rest of the whitelisted plugins.
gem "github-pages", group: :jekyll_plugins

# Ruby 3.x no longer bundles webrick, which `jekyll serve` needs.
gem "webrick", "~> 1.8"
